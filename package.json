{
  "name": "pud",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "workspaces": ["packages/*", "apps/*", "experiments/debit-endpoint"],
  "scripts": {
    "pack:cli": "bun ./packages/cli/scripts/pack.ts",
    "demo": "bun experiments/debit-endpoint/demo.ts",
    "demo:rocq": "bun packages/cli/demo/replay.ts",
    "verify": "pud",
    "test": "bun test",
    "typecheck": "tsc --noEmit && bun run --cwd apps/www typecheck && bun run --cwd apps/dex typecheck"
  },
  "devDependencies": {
    "@pud/cli": "workspace:*",
    "@types/bun": "latest",
    "typescript": "^7"
  }
}
