---
import "@fontsource-variable/atkinson-hyperlegible-mono";
import "@fontsource-variable/atkinson-hyperlegible-mono/wght-italic.css";
import "@fontsource-variable/atkinson-hyperlegible-next";
import "@fontsource-variable/atkinson-hyperlegible-next/wght-italic.css";
import "@fontsource-variable/pixelify-sans";
import readingFont from "@fontsource-variable/atkinson-hyperlegible-next/files/atkinson-hyperlegible-next-latin-wght-normal.woff2?url";
import "../styles/styles.css";
import { ClientRouter } from "astro:transitions";
import { vault } from "../lib/content";
import { outboundAttributes } from "../lib/web-links";
import { favicon, folderCount, folderLink, link } from "../lib/styles";
import Masthead from "../components/site-masthead.astro";
import Icon from "../components/dex-icon.astro";
import FolderTree from "../components/folder-tree.astro";
import SidebarPanel from "../components/sidebar-panel.astro";
import SponsorBadge from "../components/sponsor-badge.astro";
import WallpaperPicker from "../components/wallpaper-picker.astro";

interface Props { title: string; description?: string; author?: string; home?: boolean; folder?: string }
const { title, description = "The Pud company wiki, work log, and collection of links.", author, home, folder } = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site);
const { bookmarks, directory } = vault;
---
<!doctype html>
<html lang="en" class="scrollbar-gutter-stable bg-desktop font-sans leading-ui text-ink [font-synthesis:var(--font-synthesis-ui)]"
  transition:animate="none">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#123664" />
    <meta name="description" content={description} />
    {author && <meta name="author" content={author} />}
    <link rel="canonical" href={canonical} />
    <link rel="icon" href="/pud-chrome.png" type="image/png" />
    <link rel="preload" href={readingFont} as="font" type="font/woff2" crossorigin />
    <title>{home ? "PudDex" : title + " · PudDex"}</title>
    <ClientRouter fallback="swap" />
  </head>
  <body class="isolate flow-root min-h-svh min-w-70 px-6 narrow:px-3 phone:px-1.5
    [&_:where(:focus-visible)]:outline-2 [&_:where(:focus-visible)]:outline-focus [&_:where(:focus-visible)]:outline-offset-2">
    <a class:list={[link, "sr-only focus:not-sr-only focus:absolute focus:top-0 focus:left-2 focus:z-3 focus:bg-white focus:p-2.25"]} href="#content">Skip to content</a>
    <div class="pointer-events-none mx-auto mt-1 mb-window-margin grid max-w-window grid-cols-1 gap-0.5 phone:mb-1.5">
      <div class="flex min-h-13 flex-wrap items-end gap-1">
        <WallpaperPicker />
        <SponsorBadge />
      </div>
      <div data-dex-window class="pointer-events-auto border border-t-chrome-highlight border-r-chrome-shadow border-b-chrome-shadow border-l-chrome-highlight
        bg-chrome p-1 shadow-window phone:p-0.75">
        <header transition:persist={home ? "dex-home-masthead" : "dex-compact-masthead"}>
          <Masthead compact={!home} />
        </header>
        <div class="my-2 grid grid-cols-workspace items-start gap-2 narrow:grid-cols-workspace-narrow phone:my-1.5 phone:grid-cols-1 phone:gap-1.5">
          <aside class="grid min-w-0 gap-2">
            <SidebarPanel label="Folders" icon="folder">
              <div class="p-1.25 text-small">
                <a class:list={[folderLink, "font-bold"]} href="/" aria-current={home ? "page" : undefined} data-selected={home ? "" : undefined}>
                  <Icon name="open" /> All entries <span class:list={[folderCount, "font-normal"]}>{directory.notes.length}</span>
                </a>
                <FolderTree folders={directory.folders} active={folder} />
              </div>
            </SidebarPanel>
            {bookmarks && <SidebarPanel label="Bookmarks" icon="link">
              <ul class="px-2.75 py-0.5">
                {bookmarks.notes.map(note => <li class="border-t border-zinc-200 py-1.75 wrap-anywhere first:border-t-0 has-[a[target]]:relative has-[a[target]]:pl-5.5">
                  <a class:list={[link, favicon, "text-small/snug outbound:before:absolute outbound:before:top-2 outbound:before:left-0"]}
                    href={note.url ?? note.href} {...outboundAttributes(note.url)}>{note.title}{note.url && <span aria-hidden="true"> ↗</span>}</a>
                  {note.url && <small class="block font-mono text-caption/relaxed text-slate-600">{new URL(note.url).hostname}</small>}
                </li>)}
              </ul>
            </SidebarPanel>}
          </aside>
          <main id="content" class="min-w-0 focus:outline-none" tabindex="-1"><slot /></main>
        </div>
        <footer class="flex min-h-6.25 items-center border border-t-slate-400 border-r-chrome-highlight border-b-chrome-highlight border-l-slate-400 px-1.75 py-0.5">
          <span class="inline-flex items-center gap-1.5 font-mono text-caption/normal text-slate-700">
            <Icon name="disk" /> {directory.notes.length} {directory.notes.length === 1 ? "entry" : "entries"} <b class="text-slate-500">·</b> {vault.links.length} {vault.links.length === 1 ? "link" : "links"}
          </span>
        </footer>
      </div>
    </div>
  </body>
</html>
<script>
  const phone = matchMedia("(max-width: 640px)");
  document.addEventListener("astro:before-swap", ({ newDocument }) => {
    const currentPanels = new Map(Array.from(document.querySelectorAll<HTMLDetailsElement>("[data-sidebar-panel]"),
      panel => [panel.dataset.sidebarPanel, panel.open]));
    for (const panel of newDocument.querySelectorAll<HTMLDetailsElement>("[data-sidebar-panel]")) {
      panel.open = phone.matches ? false : currentPanels.get(panel.dataset.sidebarPanel) ?? panel.open;
    }
  });
</script>
