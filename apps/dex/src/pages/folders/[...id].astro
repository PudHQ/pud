---
import Shell from "../../layouts/site-shell.astro";
import Listing from "../../components/entry-list.astro";
import { vault } from "../../lib/content";
export function getStaticPaths() {
  return vault.folders.map(folder => ({ params: { id: folder.id }, props: { folder } }));
}
const { folder } = Astro.props;
---
<Shell title={folder.path} folder={folder.path}><Listing title={folder.name} folderPath={folder.path} notes={folder.notes} /></Shell>
