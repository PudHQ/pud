---
import Shell from "../../layouts/Shell.astro";
import Icon from "../../components/Icon.astro";
import Breadcrumbs from "../../components/Breadcrumbs.astro";
import { vault } from "../../lib/content";
import { authors } from "../../lib/authors";
import { outboundAttributes } from "../../lib/web-links";
import { activeBar, favicon, link, panel, reading, readingTitle } from "../../lib/styles";
export function getStaticPaths() {
  return vault.notes.map(note => ({ params: { id: note.id }, props: { note } }));
}
const { note } = Astro.props;
const author = note.author ? authors.get(note.author) : undefined;
---
<Shell title={note.title} description={note.summary || undefined} folder={note.folder} author={author?.name ?? note.author}>
  <article class={panel}>
    <div class={activeBar}><Icon name="note" /><Breadcrumbs folder={note.folder} /></div>
    <div class={reading}>
      <h1 class:list={[readingTitle, "has-[+[data-byline]]:mb-1.25"]} id={note.headingId}>{note.title}<Fragment set:html={note.titleFootnotes} /></h1>
      {note.author && <p class="mb-4 flex items-center gap-1.25 text-small text-slate-600" data-byline>By {author
        ? <a class:list={[link, "inline-flex items-center gap-1.75"]} href={author.href} rel="author">
          <span class="grid size-11 shrink-0 place-items-center bg-vermilion">
            <img class="[image-rendering:var(--rendering-pixel)]" src={author.avatar} width="36" height="36" alt="" />
          </span>{author.name}
        </a>
        : note.author}</p>}
      {note.url && <a class:list={[link, favicon, "inline-flex min-h-7 items-center gap-1.5 bg-slate-100 px-2 py-0.5 font-mono text-small/normal"]}
        href={note.url} {...outboundAttributes(note.url)}>Visit {new URL(note.url).hostname} ↗</a>}
      <div class="prose text-note" set:html={note.html}></div>
      {note.tags.length > 0 && <p class="my-3 flex flex-wrap gap-2 font-mono text-xs/normal font-label text-slate-600">{note.tags.map(tag => <span>#{tag}</span>)}</p>}
      <section class="mt-6 border-t border-line" aria-label="Backlinks">
        <h2 class="mt-4.5 mb-1.75 flex items-center gap-1.75 text-entry/tight font-panel text-navy"><Icon name="link" /> Linked from</h2>
        {note.backlinks.length
          ? <ul class="my-4 list-disc pl-5.25 text-ui/relaxed">{note.backlinks.map(source => <li><a class={link} href={source.href}>{source.title}</a></li>)}</ul>
          : <p class="my-3.5 text-ui/relaxed">No incoming links yet.</p>}
      </section>
    </div>
  </article>
</Shell>
