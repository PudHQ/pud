---
import Shell from "../../layouts/site-shell.astro";
import Listing from "../../components/entry-list.astro";
import { authors } from "../../lib/authors";
import { vault } from "../../lib/content";
import { pageTitle, panel } from "../../lib/styles";

export function getStaticPaths() {
  return [...authors.values()].map(author => ({ params: { handle: author.handle }, props: { author } }));
}
const { author } = Astro.props;
const entries = vault.notes.filter(note => note.author === author.handle);
---
<Shell title={author.name} description={`Entries by ${author.name} on PudDex.`}>
  <header class:list={[panel, "mb-2 flex items-center gap-3.75 p-3.75"]}>
    <div class="grid size-20 shrink-0 place-items-center bg-vermilion">
      <img class="[image-rendering:var(--rendering-pixel)]" src={author.avatar} width="64" height="64" alt="" />
    </div>
    <hgroup class="min-w-0 wrap-anywhere">
      <h1 class={pageTitle}>{author.name}</h1>
      <p class="mt-1.25 font-mono text-small text-slate-600">@{author.handle}</p>
    </hgroup>
  </header>
  <Listing title="Entries" notes={entries} heading="h2" />
</Shell>
