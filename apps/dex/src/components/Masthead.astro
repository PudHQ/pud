---
import { width, height, ring } from "../lib/globe";
import OrbitStamp from "./OrbitStamp.astro";
import PudFoil from "./PudFoil.astro";
const { compact = false } = Astro.props;
const globeLayer = "col-start-1 row-start-1 size-full object-contain [image-rendering:var(--rendering-pixel)]";
---
<div data-masthead class:list={[
  `group/masthead relative isolate flex items-center overflow-hidden border border-t-slate-600 border-r-chrome-highlight
    border-b-chrome-highlight border-l-slate-600 bg-(image:--background-masthead)`,
  compact
    ? "px-2.25 py-1.5"
    : "min-h-masthead-height px-masthead pt-5 pb-6 phone:min-h-masthead-phone-height phone:px-3.5 phone:py-3.5 small-phone:px-2.5",
]}>
  <div class="absolute inset-0 -z-1 bg-(image:--background-stars) bg-size-(--background-size-stars) bg-right
    mask-(--mask-stars) opacity-67" aria-hidden="true"></div>
  <div class="pointer-events-none relative z-1 w-33/50 phone:w-16/25">
    <OrbitStamp {compact} />
    {!compact && <p class="mt-3.5 max-w-masthead-copy text-masthead-caption/normal text-balance text-slate-200
      phone:mt-2 phone:max-w-masthead-copy-phone phone:text-xs/normal">A wiki, knowledge base, and microblog... Of sorts...</p>}
  </div>
  <div class:list={["pointer-events-none absolute top-0 grid h-full place-items-center",
    compact ? "right-2.25 w-30 phone:w-23.5" : "right-orbit-inset w-7/20 phone:right-0 phone:w-2/5"]}>
    <img class:list={[globeLayer, "group-data-interactive/masthead:invisible"]} src="/globe.svg" alt="" {width} {height} />
    {!compact && <>
      <canvas data-globe-canvas class:list={[globeLayer, "invisible group-data-interactive/masthead:visible"]} {width} {height} aria-hidden="true"></canvas>
      <svg data-orbit-world class={globeLayer} viewBox={`0 0 ${width} ${height}`} aria-hidden="true" focusable="false" shape-rendering="crispEdges">
        <path class="opacity-0 motion-safe:animate-water-shimmer" fill="#d6efff" d="M69 34h3v1h-3zM73 32h5v1h-5zM78 30h2v1h-2z" />
        <path class="opacity-0 motion-safe:animate-orbit-sheen" fill="none" stroke="#fff9e8" stroke-width="2" stroke-dasharray="8 110" pathLength="100"
          d={`M${-ring.rx} 0a${ring.rx} ${ring.ry} 0 0 0 ${ring.rx * 2} 0`}
          transform={`translate(${ring.cx} ${ring.cy}) rotate(${ring.angle})`} />
      </svg>
    </>}
    <PudFoil {compact} />
  </div>
  {!compact && <>
    <canvas data-orbit-sparks class="pointer-events-none absolute inset-0 z-1 size-full" aria-hidden="true" hidden></canvas>
    <template data-orbit-beacon>
      <span data-orbit-signal class="pointer-events-none absolute top-0 left-0 z-1 size-1.25 -translate-1/2 bg-amber-50 shadow-sm shadow-amber-400/70" aria-hidden="true" hidden></span>
    </template>
  </>}
</div>

<script>
  import { globeFrame, width, height, palette } from "../lib/globe";

  const mast = document.querySelector<HTMLElement>("[data-masthead]");
  const canvas = mast?.querySelector<HTMLCanvasElement>("[data-globe-canvas]");
  const ctx = canvas?.getContext("2d");
  const motion = matchMedia("(prefers-reduced-motion: reduce)");
  if (mast && canvas) void import("../lib/orbit-stamp").then(({ mountOrbitStamp }) => mountOrbitStamp(mast));
  if (mast && canvas && ctx) {
    const rgba = ctx.createImageData(width, height);
    const colors = palette.map(color => [1, 3, 5].map(i => parseInt(color.slice(i, i + 2), 16) || 0));
    let turn = 0, tilt = 0, frame = 0, last = 0;
    let arrival = motion.matches ? 0 : performance.now() + 1100;
    function draw(now: number) {
      frame = 0;
      if (now - last < 32) { frame = requestAnimationFrame(draw); return; }
      last = now;
      const remaining = Math.max(0, (arrival - now) / 1100);
      const pixels = globeFrame(turn - 0.13 * remaining ** 2, tilt);
      for (let i = 0; i < pixels.length; i++) {
        const color = colors[pixels[i]];
        rgba.data[i * 4] = color[0];
        rgba.data[i * 4 + 1] = color[1];
        rgba.data[i * 4 + 2] = color[2];
        rgba.data[i * 4 + 3] = pixels[i] ? 255 : 0;
      }
      ctx!.putImageData(rgba, 0, 0);
      mast!.style.setProperty("--pud-x", Math.round(turn * 58 - remaining * 10) + "px");
      mast!.style.setProperty("--pud-y", Math.round(tilt * -40 - remaining * 4) + "px");
      mast!.setAttribute("data-interactive", "");
      if (remaining > 0) frame = requestAnimationFrame(draw);
    }
    function reset() {
      cancelAnimationFrame(frame);
      frame = 0;
      arrival = 0;
      mast!.removeAttribute("data-interactive");
      mast!.style.removeProperty("--pud-x");
      mast!.style.removeProperty("--pud-y");
    }
    if (arrival) frame = requestAnimationFrame(draw);
    mast.addEventListener("pointermove", event => {
      if (motion.matches || event.pointerType === "touch") return;
      if (event.target instanceof Element && event.target.closest("[data-foil-control]")) return;
      const box = mast.getBoundingClientRect();
      arrival = 0;
      const x = event.clientX - box.left, y = event.clientY - box.top;
      turn = (x / box.width - 0.5) * 0.25;
      tilt = (0.5 - y / box.height) * 0.35;
      if (!frame) frame = requestAnimationFrame(draw);
    });
    mast.addEventListener("pointerleave", reset);
    motion.addEventListener("change", reset);
  }
</script>
