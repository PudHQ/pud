---
import { width, height, ring } from "../lib/globe";
import OrbitStamp from "./orbit-stamp.astro";
import PudFoil from "./pud-foil.astro";
const globeLayer = "col-start-1 row-start-1 size-full object-contain [image-rendering:var(--rendering-pixel)]";
---
<div data-masthead class="group/masthead relative isolate flex min-h-masthead-height items-center overflow-hidden border border-t-slate-600
  border-r-chrome-highlight border-b-chrome-highlight border-l-slate-600 bg-(image:--background-masthead)
  px-masthead pt-5 pb-6 phone:min-h-masthead-phone-height phone:px-3.5 phone:py-3.5 small-phone:px-2.5">
  <div class="absolute inset-0 -z-1 bg-(image:--background-stars) bg-size-(--background-size-stars) bg-right
    mask-(--mask-stars) opacity-67" aria-hidden="true"></div>
  <div class="pointer-events-none relative z-1 w-33/50 not-has-[p:not(:empty)]:invisible phone:w-16/25">
    <OrbitStamp />
    <p class="mt-3.5 max-w-masthead-copy text-masthead-caption/normal text-balance text-slate-200
      phone:mt-2 phone:max-w-masthead-copy-phone phone:text-xs/normal font-semibold italic shadow-sm">A wiki, knowledge base, and microblog... Of sorts...</p>
  </div>
  <div class="pointer-events-none absolute top-0 right-orbit-inset bottom-3 grid w-7/20 place-items-center phone:right-0 phone:bottom-2 phone:w-2/5">
    <img class:list={[globeLayer, "group-data-interactive/masthead:invisible"]} src="/globe.svg" alt="" width={width} height={height} />
    <canvas data-globe-canvas class:list={[globeLayer, "invisible group-data-interactive/masthead:visible"]} width={width} height={height} inert></canvas>
    <svg data-orbit-world class={globeLayer} viewBox={`0 0 ${width} ${height}`} aria-hidden="true" focusable="false" shape-rendering="crispEdges">
      <path class="opacity-0 motion-safe:animate-water-shimmer" fill="#d6efff" d="M69 34h3v1h-3zM73 32h5v1h-5zM78 30h2v1h-2z" />
      <path class="opacity-0 motion-safe:animate-orbit-sheen" fill="none" stroke="#fff9e8" stroke-width="2" stroke-dasharray="8 110" pathLength="100"
        d={`M${-ring.rx} 0a${ring.rx} ${ring.ry} 0 0 0 ${ring.rx * 2} 0`}
        transform={`translate(${ring.cx} ${ring.cy}) rotate(${ring.angle})`} />
    </svg>
    <PudFoil />
  </div>
  <canvas data-orbit-sparks class="pointer-events-none absolute inset-0 z-1 size-full" inert hidden></canvas>
  <template data-orbit-beacon>
    <span data-orbit-signal class="pointer-events-none absolute top-0 left-0 z-1 size-1.25 -translate-1/2 bg-amber-50 shadow-sm shadow-amber-400/70" aria-hidden="true" hidden></span>
  </template>
</div>

<script>
  import { globeFrame, width, height, palette } from "../lib/globe";
  import { dampAxis, motionAxis, restingRate, trackingRate } from "../lib/masthead-motion";
  import { mountRouteElement } from "../lib/mount-route-element";

  function mountGlobe(mast: HTMLElement, ctx: CanvasRenderingContext2D, signal: AbortSignal) {
    const motion = matchMedia("(prefers-reduced-motion: reduce)");
    const rgba = ctx.createImageData(width, height);
    const colors = palette.map(color => [1, 3, 5].map(i => parseInt(color.slice(i, i + 2), 16) || 0));
    const opening = !motion.matches && !document.hidden;
    const turn = motionAxis(opening ? -.13 : 0), tilt = motionAxis();
    const stickerX = motionAxis(opening ? -10 : 0), stickerY = motionAxis(opening ? -4 : 0);
    let targetTurn = 0, targetTilt = 0, tracking = false;
    let rate = opening ? 8.5 : restingRate;
    let frame = 0, last = 0, lastPaint = -Infinity;

    function paint() {
      const pixels = globeFrame(turn.value, tilt.value);
      for (let i = 0; i < pixels.length; i++) {
        const color = colors[pixels[i]];
        rgba.data[i * 4] = color[0];
        rgba.data[i * 4 + 1] = color[1];
        rgba.data[i * 4 + 2] = color[2];
        rgba.data[i * 4 + 3] = pixels[i] ? 255 : 0;
      }
      ctx.putImageData(rgba, 0, 0);
      mast.setAttribute("data-interactive", "");
    }

    function showPoster() {
      last = 0;
      lastPaint = -Infinity;
      mast.removeAttribute("data-interactive");
      mast.style.removeProperty("--pud-x");
      mast.style.removeProperty("--pud-y");
    }

    function wake() {
      if (!frame && !motion.matches && !document.hidden) frame = requestAnimationFrame(draw);
    }

    function draw(now: number) {
      frame = 0;
      const dt = Math.min(.05, last ? (now - last) / 1000 : 1 / 60);
      last = now;
      const turning = dampAxis(turn, targetTurn, rate, dt, .0005);
      const tilting = dampAxis(tilt, targetTilt, rate, dt, .0005);
      const driftingX = dampAxis(stickerX, targetTurn * 58, rate, dt, .025);
      const driftingY = dampAxis(stickerY, targetTilt * -40, rate, dt, .025);
      const moving = turning || tilting || driftingX || driftingY;
      if (!tracking && !moving) {
        showPoster();
        return;
      }

      mast.style.setProperty("--pud-x", `${stickerX.value.toFixed(3)}px`);
      mast.style.setProperty("--pud-y", `${stickerY.value.toFixed(3)}px`);
      // The sticker can glide every frame while the pixel globe keeps its 30 fps budget.
      if (now - lastPaint >= 32 || !moving) {
        lastPaint = now;
        paint();
      }
      if (moving) wake();
      else last = 0;
    }

    function follow(event: PointerEvent) {
      if (motion.matches || !event.isPrimary || event.pointerType === "touch") return;
      if (event.target instanceof Element && event.target.closest("[data-foil-control]")) return;
      const box = mast.getBoundingClientRect();
      const x = event.clientX - box.left, y = event.clientY - box.top;
      targetTurn = (x / box.width - 0.5) * 0.25;
      targetTilt = (0.5 - y / box.height) * 0.35;
      tracking = true;
      rate = trackingRate;
      wake();
    }

    function returnToRest(event: PointerEvent) {
      if (!tracking || !event.isPrimary || event.pointerType === "touch") return;
      tracking = false;
      targetTurn = targetTilt = 0;
      rate = restingRate;
      wake();
    }

    function reset() {
      cancelAnimationFrame(frame);
      frame = 0;
      tracking = false;
      targetTurn = targetTilt = 0;
      for (const axis of [turn, tilt, stickerX, stickerY]) axis.value = axis.velocity = 0;
      showPoster();
    }

    mast.addEventListener("pointerenter", follow, { signal });
    mast.addEventListener("pointermove", follow, { signal });
    mast.addEventListener("pointerleave", returnToRest, { signal });
    mast.addEventListener("pointercancel", returnToRest, { signal });
    motion.addEventListener("change", reset, { signal });
    document.addEventListener("visibilitychange", () => { if (document.hidden) reset(); }, { signal });
    window.addEventListener("pagehide", reset, { signal });
    signal.addEventListener("abort", reset, { once: true });
    if (opening) wake();
  }

  mountRouteElement<HTMLCanvasElement>("[data-globe-canvas]", (canvas, signal) => {
    const mast = canvas.closest<HTMLElement>("[data-masthead]")!;
    void import("../lib/orbit-stamp").then(({ mountOrbitStamp }) => {
      if (!signal.aborted) mountOrbitStamp(mast, signal);
    });
    const ctx = canvas.getContext("2d");
    if (ctx) mountGlobe(mast, ctx, signal);
  });
</script>
