---
const wallpapers = [
  { id: "brick", label: "Brick" },
  { id: "corkboard", label: "Corkboard" },
  { id: "starfield", label: "Starfield" },
  { id: "circuit", label: "Circuit board" },
  { id: "aquarium", label: "Aquarium" },
  { id: "plain", label: "No wallpaper" },
];
---
<div data-wallpaper-backdrop class="pointer-events-auto fixed inset-0 -z-1 overflow-hidden bg-(image:--wallpaper-tile)" aria-hidden="true">
  <div class="pointer-events-none absolute inset-0 -right-4 -bottom-2 bg-(image:--wallpaper-light) opacity-35 motion-safe:animate-(--wallpaper-motion)"></div>
  <div class="pointer-events-none absolute inset-0 -bottom-6 bg-(image:--wallpaper-accent) opacity-35 motion-safe:animate-(--wallpaper-accent-motion)"></div>
  <canvas class="pointer-events-none absolute inset-0 size-full [image-rendering:var(--rendering-pixel)]" width="1" height="1"></canvas>
</div>
<fieldset data-wallpaper-picker class="pointer-events-auto min-w-0">
  <legend class="sr-only">Desktop wallpaper</legend>
  <div class="flex items-end gap-0.75 small-phone:gap-0.25">
    {wallpapers.map(({ id, label }) => (
      <label class="group grid h-11 w-10 shrink-0 items-end phone:w-8 small-phone:w-7" title={label}>
        <input class="peer sr-only" type="radio" name="wallpaper" id={`wallpaper-${id}`} value={id}
          checked={id === "starfield"} aria-label={label} />
        <span class="pointer-events-none relative block h-7.75 border-2 border-t-slate-400 border-r-slate-950 border-b-slate-950 border-l-slate-400
          bg-slate-900 p-0.5 shadow-window after:absolute after:top-px after:right-px after:hidden after:size-1 after:bg-amber-200
          peer-checked:border-amber-200 peer-checked:after:block peer-focus-visible:outline-2 peer-focus-visible:outline-offset-2
          peer-focus-visible:outline-cyan-200 group-active:translate-y-px" aria-hidden="true">
          {id === "plain"
            ? <span class="grid size-full place-items-center bg-desktop">
                <span class="grid h-3.5 w-4 place-items-center border border-slate-500">
                  <span class="h-0.5 w-4 -rotate-45 bg-slate-300"></span>
                </span>
              </span>
            : <span class="block size-full bg-(image:--wallpaper-preview) bg-center brightness-160 group-hover:brightness-200"
                style={`--wallpaper-preview: url('/wallpapers/${id}.png')`}></span>}
        </span>
      </label>
    ))}
  </div>
</fieldset>

<script is:inline>
  (() => {
    const picker = document.querySelector("[data-wallpaper-picker]");
    if (!picker) return;

    const choices = Array.from(picker.querySelectorAll('input[type="radio"]'));
    const fallback = choices.find(choice => choice.defaultChecked);
    const key = "puddex:wallpaper";
    const notify = () => picker.dispatchEvent(new Event("wallpaperchange"));

    function restorePreference() {
      try {
        const saved = localStorage.getItem(key);
        const choice = choices.find(choice => choice.value === saved) ?? fallback;
        if (choice && !choice.checked) {
          choice.checked = true;
          notify();
        }
      } catch {
        // The picker still works when storage is unavailable.
      }
    }

    restorePreference();
    picker.addEventListener("change", event => {
      const choice = event.target;
      if (!(choice instanceof HTMLInputElement) || !choice.checked) return;
      try { localStorage.setItem(key, choice.value); } catch {}
      notify();
    });
    window.addEventListener("pageshow", restorePreference);
    window.addEventListener("storage", event => {
      if (event.key === key || event.key === null) restorePreference();
    });
  })();
</script>

<script>
  import { mountWallpaperEffects } from "../lib/wallpaper-effects";

  const backdrop = document.querySelector<HTMLElement>("[data-wallpaper-backdrop]");
  const picker = document.querySelector<HTMLFieldSetElement>("[data-wallpaper-picker]");
  const desktop = document.querySelector<HTMLElement>("[data-dex-window]");
  if (backdrop && picker && desktop) mountWallpaperEffects(backdrop, picker, desktop);
</script>
