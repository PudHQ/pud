---
import Icon from "./dex-icon.astro";
import NoteIcon from "./note-icon.astro";
import type { Folder, Note } from "../lib/vault";
import { folderCount, summary, treeLink } from "../lib/styles";

interface Props { folders: Folder[]; notes: Note[]; active?: string; level?: number }
const { folders, notes, active, level = 0 } = Astro.props;
const { pathname } = Astro.url;
const notePage = pathname.startsWith("/notes/");
const branch = `before:absolute before:inset-y-0 before:left-branch-line before:border-l before:border-dotted before:border-slate-400
  last:before:bottom-auto last:before:h-3.75 after:pointer-events-none after:absolute after:top-3.5 after:left-branch-line after:w-3.25 after:border-t after:border-dotted after:border-slate-400`;
const row = level > 0 ? `relative ${branch}` : "relative";
---
<ul style={`--branch-indent: ${7 + level * 13}px`}>
  {folders.map(folder => {
    const current = pathname === folder.href;
    const activeBranch = active === folder.path || active?.startsWith(folder.path + "/");
    const childNotes = folder.notes.filter(note => note.folder === folder.path);
    const disclosureLabel = "Contents of " + folder.path;
    return <li class={row}>
      <a href={folder.href} class={treeLink} data-selected={current ? "" : undefined} aria-current={current ? "page" : undefined}>
        <Icon name={active === folder.path ? "open" : "folder"} /> {folder.name} <span class={folderCount}>{folder.notes.length}</span>
      </a>
      {(folder.children.length > 0 || childNotes.length > 0) && <details data-sidebar-disclosure={folder.href}
        data-contains-current-note={notePage && activeBranch ? "" : undefined}
        open={activeBranch || (level === 0 && folder.children.length > 0)}>
        <summary class:list={[summary, `absolute top-0.25 left-branch-toggle z-1 grid h-6.75 w-3.75 place-items-center
          before:grid before:size-2.75 before:place-items-center before:border before:border-chrome-edge before:bg-paper before:font-mono before:text-caption before:leading-none
          before:content-(--disclosure-closed) expanded:before:content-(--disclosure-open)`]}
          aria-label={disclosureLabel} title={disclosureLabel}></summary>
        <Astro.self folders={folder.children} notes={childNotes} active={active} level={level + 1} />
      </details>}
    </li>;
  })}
  {notes.map(note => {
    const current = pathname === note.href;
    return <li class={row}>
      <a href={note.href} class={treeLink} title={note.title} data-selected={current ? "" : undefined} aria-current={current ? "page" : undefined}>
        <NoteIcon note={note} />
        <span class="truncate">{note.title}</span>
      </a>
    </li>;
  })}
</ul>
