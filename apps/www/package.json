{
  "name": "@pud/www",
  "private": true,
  "type": "module",
  "engines": {
    "node": "^22.23.0 || ^24.22.0 || ^26.12.0"
  },
  "scripts": {
    "dev": "\"$npm_execpath\" run alpha:migrate:local && vite dev",
    "build": "vite build",
    "preview": "vite preview",
    "start": "\"$npm_execpath\" run preview",
    "typecheck": "cf workers types && tsc --noEmit",
    "deploy": "vinext-cloudflare deploy",
    "alpha:migrate:local": "cf d1 migrations apply 00000000-0000-4000-8000-000000004901 --local",
    "alpha:list": "cf d1 raw 00000000-0000-4000-8000-000000004901 --local --sql \"SELECT email, joined_at FROM alpha_signups ORDER BY joined_at DESC, email\""
  },
  "dependencies": {
    "@pud/analytics": "workspace:*",
    "@vinext/cloudflare": "catalog:",
    "react": "catalog:",
    "react-dom": "catalog:",
    "react-server-dom-webpack": "catalog:",
    "vinext": "catalog:"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "catalog:",
    "@tailwindcss/vite": "catalog:",
    "@types/node": "catalog:",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "@vitejs/plugin-react": "catalog:",
    "@vitejs/plugin-rsc": "catalog:",
    "cf": "catalog:",
    "tailwindcss": "catalog:",
    "typescript": "catalog:",
    "vite": "catalog:"
  }
}
